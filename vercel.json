{
  "buildCommand": "yarn build",
  "outputDirectory": "dist",
  "devCommand": "yarn dev",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "mode" }],
      "missing": [{ "type": "query", "key": "_" }],
      "destination": "/api/preview"
    }
  ]
}
